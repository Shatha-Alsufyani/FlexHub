FROM jupyterhub/jupyterhub:latest

# Install JupyterLab, Azure AD OAuthenticator, and dotenv
RUN pip install --no-cache-dir jupyterlab oauthenticator python-dotenv

# Copy our custom configuration
COPY backend/api/jupyterhub_config.py /srv/jupyterhub/jupyterhub_config.py

# Expose the proxy and API ports
EXPOSE 8001 8081

# Run JupyterHub using our config
CMD ["jupyterhub", "-f", "/srv/jupyterhub/jupyterhub_config.py"]