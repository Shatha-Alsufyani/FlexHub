# Copy to .env and fill in real values.
#
# The Hub REST API port -- this is the Hub's own port (JupyterHub.hub_port,
# default 8081), NOT the public proxy port 8000. This FastAPI app listens on
# 8000 itself, so pointing HUB_API_URL at 8000 makes it call itself.
HUB_API_URL=http://127.0.0.1:8081/hub/api

# Shared secret between this backend and JupyterHub. jupyterhub_config.py
# registers it as the flexhub-backend service token, so any long random string
# works. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
HUB_TOKEN=afd82fa5d2dc2ef8bef79667062656924d7ac4788a3f60d9dffac7a1244867f5

# Dev-only shared password for DummyAuthenticator (browser login at :8001).
HUB_DEV_PASSWORD=flexhub-dev

AZURE_STORAGE_CONNECTION_STRING="your_azure_storage_connection_string_here"
AZURE_CONTAINER_NAME="user-uploads"